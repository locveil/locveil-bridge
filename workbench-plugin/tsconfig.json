{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      /* The Workbench plugin contract compiles from the PINNED bytes
         (../contracts/pins/workbench/, moved only by a deliberate re-pin) — never
         from a commons checkout. There is no `locveil-workbench` package installed:
         the imports are type-only and erased at build. The pinned file imports React
         types and sits outside any node_modules, so `react` is mapped to this
         package's own copy. Guarded by backend/tests/unit/test_workbench_pin.py. */
      "locveil-workbench/contract": ["../contracts/pins/workbench/contract.ts"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
